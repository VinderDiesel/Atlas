      "title": "token 消耗速率",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按回合类型拆分吞吐：answer/clarify/blocked/error/handoff——拒绝率与故障率审计的可视化基线",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
