# ---- 复制为 .env 后填写；.env 已 gitignore，禁止提交真实值 ----

# ===== Apache Iceberg + Polaris =====
POLARIS_REALM=POLARIS
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=
POLARIS_CATALOG_URI=http://localhost:8181/api/catalog
POLARIS_WAREHOUSE=atlas_wh
ICEBERG_CATALOG_NAME=iceberg_rest
# 降级路径（ADR-0004）：Polaris 部署失败时改用 hadoop catalog
ICEBERG_FALLBACK_CATALOG_TYPE=hadoop

# ===== MinIO（S3 兼容对象存储）=====
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=atlas-warehouse

# ===== Apache Doris 4.1（MySQL 协议）=====
DORIS_FE_HOST=localhost
DORIS_QUERY_PORT=9030
DORIS_HTTP_PORT=8030
DORIS_USER=root
DORIS_PASSWORD=
# 只读账号：纵深防御，应用层不允许任何写操作
DORIS_RO_USER=atlas_ro
DORIS_RO_PASSWORD=

# ===== PostgreSQL（Polaris 元数据 + Atlas 元数据/策略）=====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atlas_meta
POSTGRES_USER=atlas
POSTGRES_PASSWORD=

# ===== Milvus（向量检索，语义召回）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== LLM =====
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=deepseek-v4-flash
LOCAL_VLLM_ENDPOINT=http://localhost:8000/v1
LOCAL_MODEL_NAME=

# ===== 可观测 =====
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=atlas

# ===== 安全 =====
JWT_SECRET=
MAX_QUERY_ROWS=10000
MAX_QUERY_DAYS=730
COST_BUDGET_USD=1.0
ATLAS_JWT_SECRET=
# Polaris 受限只读 principal（serving/rbac_verify.py，首次 --ensure 创建时输出）
POLARIS_RBAC_CLIENT_ID=
POLARIS_RBAC_CLIENT_SECRET=
